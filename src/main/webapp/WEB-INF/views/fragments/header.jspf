<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>AstroBookings - Rocket launch catalog</title>
    <link rel="stylesheet" href="<c:url value='/assets/css/main.css'/>">
</head>
<body>
<header class="site-header">
    <div class="site-header__inner">
        <a class="brand" href="<c:url value='/launches'/>">
            <span class="brand__mark" aria-hidden="true">&#9733;</span>
            <span class="brand__text">AstroBookings</span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
            <a href="<c:url value='/launches'/>">Launches</a>
            <c:choose>
                <c:when test="${empty sessionScope['auth.token']}">
                    <a href="<c:url value='/login'/>">Log in</a>
                    <a class="button button--small" href="<c:url value='/register'/>">Register</a>
                </c:when>
                <c:otherwise>
                    <span class="session-user">
                        Signed in as <c:out value="${sessionScope['auth.username']}"/>
                    </span>
                    <a href="<c:url value='/bookings'/>">My bookings</a>
                </c:otherwise>
            </c:choose>
        </nav>
    </div>
</header>
<main class="site-main">
